#include <iostream>
using namespace std;

class Queue
{
    int arr[100];
    int front, rear;

public:
    Queue()
    {
        front = -1;
        rear = -1;
    }

    void enqueue(int value)
    {
        if (rear == 99)
        {
            cout << "Queue Overflow!" << endl;
        }
        else
        {
            if (front == -1)
                front = 0;

            rear++;
            arr[rear] = value;
            cout << value << " inserted into queue." << endl;
        }
    }

    void dequeue()
    {
        if (front == -1 || front > rear)
        {
            cout << "Queue Underflow!" << endl;
        }
        else
        {
            cout << arr[front] << " removed from queue." << endl;
            front++;

            if (front > rear)
            {
                front = rear = -1;
            }
        }
    }

    void peek()
    {
        if (front == -1)
        {
            cout << "Queue is empty." << endl;
        }
        else
        {
            cout << "Front element is: " << arr[front] << endl;
        }
    }

    void display()
    {
        if (front == -1)
        {
            cout << "Queue is empty." << endl;
        }
        else
        {
            cout << "Queue elements are: ";
            for (int i = front; i <= rear; i++)
            {
                cout << arr[i] << " ";
            }
            cout << endl;
        }
    }

    bool isEmpty()
    {
        return (front == -1);
    }
};

int main()
{
    Queue q;

    q.enqueue(10);
    q.enqueue(20);
    q.enqueue(30);

    q.display();

    q.peek();

    q.dequeue();

    q.display();

    if (q.isEmpty())
    {
        cout << "Queue is empty." << endl;
    }
    else
    {
        cout << "Queue is not empty." << endl;
    }

    return 0;
}
